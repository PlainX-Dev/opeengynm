# Loaded only by `npm run build:vercel` (vite --mode vercel) — the Docker build never sees it.
#
# Serverless deployment: no backend, so the app boots straight into local (guest) mode
# (see src/lib/standalone.js), and the ~140 MB of exercise images/GIFs are read from the
# upstream dataset on jsDelivr instead of a media volume. Pinned to the same commit the
# GitHub Pages demo and the mobile build use, so the CDN can cache it forever.
VITE_STANDALONE=1
VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/
VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/
